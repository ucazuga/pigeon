{
	"$schema": "../../node_modules/wrangler/config-schema.json",
	"name": "pigeon",
	"main": "src/index.ts",
	"compatibility_date": "2026-11-01",
	// Logo, favicon and the pages' script, served as static files before the Worker runs.
	"assets": { "directory": "./public" },
	// Bundles the pages' script (src/web/client) into public/js before every `wrangler dev` and `wrangler deploy`.
	"build": {
		"command": "bun build src/web/client/pigeon.client.ts --outfile public/js/pigeon.js --minify",
		"watch_dir": "src"
	},
	"observability": { "enabled": true },
	// The hosted relay. Self-hosting: replace with your own domain, or remove to use workers.dev only.
	"routes": [{ "pattern": "pigeon.ucazuga.com", "custom_domain": true }],
	"workers_dev": false,
	"preview_urls": false,
	// Set per deployment, not in this file: PUBLIC_URL (the relay's public origin), SESSION_SIGNING_KEY, and
	// EMAIL_FROM (a sender on a domain onboarded with `wrangler email sending enable <domain>`).
	// Production: `wrangler secret put <NAME>`. Local: copy .dev.vars.example to .dev.vars.
	"send_email": [{ "name": "EMAIL" }],
	// Abuse limits per minute: sign-in emails per IP and per address, and invite claims per IP.
	"ratelimits": [
		{
			"name": "LOGIN_LIMITER",
			"namespace_id": "4101",
			"simple": { "limit": 5, "period": 60 }
		},
		{
			"name": "JOIN_LIMITER",
			"namespace_id": "4102",
			"simple": { "limit": 10, "period": 60 }
		}
	],
	"d1_databases": [
		{
			"binding": "DB",
			"database_name": "pigeon",
			"database_id": "1edfb3a6-3a45-4412-b2b4-2508c9f5c948",
			"migrations_dir": "src/infrastructure/d1/migrations"
		}
	],
	"durable_objects": {
		"bindings": [{ "name": "TEAM_ROOM", "class_name": "TeamRoom" }],
		// A team room with open event streams never hibernates, so a deferred update would wait the full default
		// 5 minutes. 60 seconds lets a running wait_for_answer (45 s) finish; monitors then reconnect with Last-Event-ID.
		"code_update_strategy": { "mode": "deferred", "max_delay": 60 }
	},
	"migrations": [{ "tag": "v1", "new_sqlite_classes": ["TeamRoom"] }]
}
