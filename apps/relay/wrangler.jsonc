{
	"$schema": "../../node_modules/wrangler/config-schema.json",
	"name": "pigeon",
	"main": "src/index.ts",
	"compatibility_date": "2026-11-01",
	// Logo and favicon, served as static files before the Worker runs.
	"assets": { "directory": "./public" },
	"observability": { "enabled": true },
	// Set per deployment, not in this file: PUBLIC_URL (the relay's public origin), SESSION_SIGNING_KEY, and
	// EMAIL_FROM (a sender on a domain onboarded with `wrangler email sending enable <domain>`).
	// Production: `wrangler secret put <NAME>`. Local: copy .dev.vars.example to .dev.vars.
	"send_email": [{ "name": "EMAIL" }],
	"d1_databases": [
		{
			"binding": "DB",
			"database_name": "pigeon",
			"database_id": "1edfb3a6-3a45-4412-b2b4-2508c9f5c948",
			"migrations_dir": "src/infrastructure/d1/migrations"
		}
	],
	"durable_objects": {
		"bindings": [{ "name": "TEAM_ROOM", "class_name": "TeamRoom" }]
	},
	"migrations": [{ "tag": "v1", "new_sqlite_classes": ["TeamRoom"] }]
	// Email sending binding is added when the magic-link mailer is implemented (Cloudflare Email Service).
}
