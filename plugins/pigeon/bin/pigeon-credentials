#!/bin/sh
# Shared helper, sourced by the other scripts. Reads ~/.pigeon/credentials.json (written by pigeon-join)
# without jq: the relay writes it as one line of JSON.stringify output.
PIGEON_HOME="${PIGEON_HOME:-$HOME/.pigeon}"
PIGEON_CREDENTIALS="$PIGEON_HOME/credentials.json"

pigeon_field() {
	sed -n "s/.*\"$1\":\"\([^\"]*\)\".*/\1/p" "$PIGEON_CREDENTIALS"
}

pigeon_require_credentials() {
	if [ ! -r "$PIGEON_CREDENTIALS" ]; then
		echo "pigeon: not joined yet. Run: pigeon-join <invite-code> <relay-url>" >&2
		exit 3
	fi
}

# This plugin's version, from its manifest. The relay uses it to tell outdated plugins to update.
pigeon_plugin_version() {
	sed -n 's/.*"version": *"\([0-9][0-9]*\.[0-9][0-9]*\.[0-9][0-9]*\)".*/\1/p' \
		"$(dirname "$0")/../.claude-plugin/plugin.json" | head -n 1
}

# Print a curl config that sends the member token and the plugin version, so the token never appears in argv (`ps`).
# Use with `curl -K -`.
pigeon_auth_config() {
	printf 'header = "Authorization: Bearer %s"\n' "$(pigeon_field member_token)"
	printf 'header = "X-Pigeon-Plugin-Version: %s"\n' "$(pigeon_plugin_version)"
}

# IDs from the relay are only ever letters, digits, `-` and `_`. Anything else is refused before it reaches a URL.
pigeon_is_id() {
	case "$1" in
		'' | *[!A-Za-z0-9_-]*) return 1 ;;
		*) return 0 ;;
	esac
}
